{
  "schema_version": 1,
  "enabled": true,
  "lang": "en",
  "languages": [
    "en",
    "ms"
  ],
  "port": 4173,
  "node": {
    "min_major": 20
  },
  "sandbox": {
    "image": "node:22-bookworm-slim",
    "work_dir": "",
    "min_free_gb": 25,
    "disk_path": "/",
    "cpus": 2,
    "memory": "3g",
    "pids_limit": 512,
    "label": "bumpproof=1",
    "user": "",
    "container_prefix": "bumpproof",
    "setup_timeout_s": 900,
    "serve_timeout_s": 90,
    "port_wait_s": 600,
    "poll_ms": 1000,
    "health_path": "/",
    "health_max_status": 399,
    "log_tail_lines": 40,
    "home": "/tmp/home",
    "env": {
      "CI": "1",
      "NODE_ENV": "production",
      "npm_config_update_notifier": "false"
    },
    "lockfiles": {
      "package-lock.json": "npm",
      "npm-shrinkwrap.json": "npm",
      "yarn.lock": "yarn",
      "pnpm-lock.yaml": "pnpm"
    },
    "install": {
      "npm": "npm ci --ignore-scripts --include=dev --no-audit --no-fund",
      "yarn": "corepack yarn install --frozen-lockfile --ignore-scripts --production=false",
      "pnpm": "corepack pnpm install --frozen-lockfile --ignore-scripts --prod=false"
    },
    "run_script": {
      "npm": "npm run",
      "yarn": "corepack yarn run",
      "pnpm": "corepack pnpm run"
    },
    "build_script": "build",
    "serve_presets": [
      {
        "dependency": "vite",
        "command": "npx --no-install vite preview --host 0.0.0.0 --port {port} --strictPort"
      },
      {
        "dependency": "next",
        "command": "npx --no-install next start -H 0.0.0.0 -p {port}"
      }
    ],
    "serve_scripts": [
      "start",
      "serve",
      "preview"
    ]
  },
  "kane": {
    "command": "kane-cli",
    "chrome_path": "",
    "chrome_dir": "~/.local/share/bumpproof/chrome",
    "chrome_names": [
      "google-chrome",
      "google-chrome-stable",
      "chromium",
      "chromium-browser"
    ],
    "journeys_dir": ".bumpproof/journeys",
    "journey_suffix": "_test.md",
    "timeout_s": 900,
    "credit_hard_stop": 9000,
    "census_budget": 4000,
    "testmd_args": [
      "--agent",
      "--headless",
      "--bug-detection",
      "continue"
    ],
    "ledger_path": "census/kredit.json",
    "bug_result_code": 740
  },
  "fixer": {
    "command": "claude",
    "model": "claude-opus-5-5",
    "max_attempts": 2,
    "max_patch_lines": 300,
    "mode": "host",
    "timeout_s": 1200,
    "args": [
      "-p",
      "--model",
      "{model}",
      "--tools",
      "Read,Edit,Write,Glob,Grep",
      "--restricted",
      "--strict-mcp-config",
      "--no-session-persistence",
      "--permission-mode",
      "acceptEdits",
      "--output-format",
      "json"
    ],
    "explanation_file": "BUMPPROOF_FIX.md",
    "patch_file": "fix.patch",
    "protected_paths": [
      ".bumpproof/**",
      "**/*_test.md",
      "output-*/**",
      "**/output-*/**",
      ".github/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**"
    ],
    "deny_patterns": [
      "child_process",
      "\\beval\\s*\\(",
      "new\\s+Function\\s*\\("
    ],
    "snapshot_skip": [
      "node_modules",
      ".git",
      "dist",
      "build",
      ".next",
      ".vite",
      "coverage"
    ],
    "build_log_lines": 200,
    "canary_path": "~/.cache/bumpproof/kanari.txt",
    "container": {
      "image": "node:22-bookworm-slim",
      "command": [
        "npx",
        "--yes",
        "@anthropic-ai/claude-code@2.1.330"
      ],
      "work_dir": "/work",
      "env": [
        "ANTHROPIC_API_KEY"
      ]
    }
  },
  "notes": {
    "registry": "https://registry.npmjs.org",
    "max_kb": 24,
    "timeout_ms": 15000,
    "max_releases": 100,
    "changelog_files": [
      "CHANGELOG.md",
      "History.md",
      "HISTORY.md"
    ],
    "guides": {
      "react-router-dom": "https://raw.githubusercontent.com/remix-run/react-router/main/docs/upgrading/future.md",
      "@tanstack/react-query": "https://raw.githubusercontent.com/TanStack/query/main/docs/framework/react/guides/migrating-to-v5.md"
    }
  },
  "github": {
    "command": "gh"
  },
  "pr": {
    "write_repos": [
      "https://github.com/aimanmalib/bumpproof"
    ],
    "fix_commit_message": "Fix the {name} {from} -> {to} upgrade\n\nPatched by Claude Code inside Bumpproof and replayed with Kane CLI\nagainst the base journeys (run {run}).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
  },
  "doctor": {
    "timeout_ms": 45000
  },
  "publish": {
    "email_allowlist": [
      "example.com",
      "noreply.github.com"
    ],
    "strip_keys": [
      "email",
      "user_email",
      "username",
      "user_name",
      "ran_by",
      "run_by",
      "test_url",
      "share_url",
      "cookie",
      "set-cookie",
      "authorization",
      "proxy-authorization",
      "access_key",
      "accesskey",
      "x-api-key"
    ],
    "email_ignore_tlds": [
      "png",
      "jpg",
      "jpeg",
      "gif",
      "svg",
      "webp",
      "avif",
      "js",
      "mjs",
      "css",
      "map",
      "json",
      "ts",
      "tsx"
    ],
    "private_url_patterns": [
      "https?://[a-z0-9.-]*lambdatest(?:internal)?\\.com[^\\s\"'<>)\\]]*",
      "https?://[a-z0-9.-]*test-manager[^\\s\"'<>)\\]]*"
    ],
    "public_strings": [
      "github.com/aimanmalib/bumpproof",
      "github:aimanmalib/bumpproof",
      "aimanmalib.github.io/bumpproof"
    ],
    "secret_env": [
      "KANE_USERNAME",
      "BUMPPROOF_PRIVATE_EMAILS"
    ],
    "scan_dirs": [
      "docs",
      "census"
    ],
    "scan_exts": [
      "html",
      "htm",
      "json",
      "ndjson",
      "md",
      "txt",
      "js",
      "css",
      "svg",
      "xml",
      "csv"
    ]
  },
  "bump": {
    "dep_fields": [
      "dependencies",
      "devDependencies",
      "optionalDependencies",
      "peerDependencies"
    ]
  },
  "compare": {
    "console_errors_fail": false,
    "network_errors_fail": false,
    "network_min_status": 400,
    "inconclusive_retries": 1
  },
  "evidence": {
    "image_exts": [
      "png",
      "jpg",
      "jpeg",
      "webp"
    ]
  },
  "app": {
    "dir": "",
    "install": "",
    "build": "",
    "serve": ""
  },
  "report": {
    "out_dir": "docs",
    "runs_dir": "docs/runs",
    "census_path": "census/results.json",
    "readme_path": "README.md",
    "repo_url": "https://github.com/aimanmalib/bumpproof",
    "pages_url": "https://aimanmalib.github.io/bumpproof/",
    "install_command": "npm install -g --install-links github:aimanmalib/bumpproof\nbumpproof doctor\nbumpproof pr <owner>/<repo>#<number> --fix",
    "replay_command": "npx github:aimanmalib/bumpproof replay docs/runs/{id}",
    "proof_links": [
      {
        "key": "judges_rules",
        "path": "src/compare.ts"
      },
      {
        "key": "judges_guards",
        "path": "test/guards.test.ts"
      },
      {
        "key": "judges_sandbox",
        "path": "src/sandbox.ts"
      },
      {
        "key": "judges_kane",
        "path": "src/kane.ts"
      },
      {
        "key": "judges_decisions",
        "path": "docs/02-DECISIONS.md"
      }
    ]
  },
  "replay": {
    "speed": 40,
    "max_gap_ms": 900
  },
  "census": {
    "created_since": "2026-10-22",
    "bots": [
      {
        "name": "dependabot",
        "author": "app/dependabot",
        "title": "bump {pkg} from"
      },
      {
        "name": "renovate",
        "author": "app/renovate",
        "title": "update dependency {pkg}"
      }
    ],
    "watchlist": [
      "react-router-dom",
      "@tanstack/react-query",
      "date-fns",
      "tailwindcss",
      "vite",
      "next",
      "react",
      "@mui/material",
      "zod",
      "react-hook-form",
      "framer-motion",
      "axios",
      "swr",
      "recharts",
      "chart.js",
      "styled-components",
      "antd",
      "i18next"
    ],
    "max_searches": 60,
    "search_gap_ms": 5000,
    "request_gap_ms": 400,
    "per_page": 30,
    "rate_limit_wait_s": 60,
    "max_evaluate": 300,
    "timebox_min": 75,
    "licenses": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "MPL-2.0"
    ],
    "max_repo_mb": 50,
    "frameworks": {
      "vite": "vite",
      "next": "next",
      "react-scripts": "cra",
      "astro": "astro"
    },
    "lifecycle_scripts": [
      "preinstall",
      "postinstall",
      "prepare"
    ],
    "env_files": [
      ".env.example",
      ".env.sample"
    ],
    "env_key_pattern": "API_KEY|SECRET|DATABASE_URL|TOKEN",
    "require_lockfile": true,
    "candidates_path": "census/candidates.json",
    "target_eligible": 20,
    "run_limit": 4,
    "run_timebox_min": 360,
    "generic_journeys_dir": "config/census-journeys",
    "specific_journeys_dir": "census/journeys",
    "runs_dir": "census/runs"
  },
  "init": {
    "templates": {
      "home": "config/census-journeys/home_test.md",
      "nav": "config/census-journeys/nav_test.md",
      "page": "config/init-journeys/page_test.md"
    },
    "source_dirs": [
      "src",
      "app",
      "pages"
    ],
    "source_exts": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "mjs",
      "vue",
      "svelte",
      "astro"
    ],
    "skip_dirs": [
      "node_modules",
      ".git",
      "dist",
      "build",
      ".next",
      "coverage",
      "__tests__"
    ],
    "max_files": 400,
    "route_patterns": [
      "\\bpath\\s*[=:]\\s*[\"'](/[^\"'\\s]*)[\"']",
      "\\b(?:to|href)\\s*=\\s*\\{?\\s*[\"'](/[^\"'\\s]*)[\"']"
    ],
    "file_route_dirs": [
      "app",
      "pages"
    ],
    "max_page_journeys": 1
  }
}

{
  "schema_version": 1,
  "enabled": true,
  "lang": "en",
  "languages": [
    "en",
    "ms"
  ],
  "port": 4173,
  "node": {
    "min_major": 20
  },
  "sandbox": {
    "image": "node:22-bookworm-slim",
    "work_dir": "",
    "min_free_gb": 25,
    "disk_path": "/",
    "cpus": 2,
    "memory": "3g",
    "pids_limit": 512,
    "label": "bumpproof=1",
    "user": "",
    "container_prefix": "bumpproof",
    "setup_timeout_s": 900,
    "serve_timeout_s": 90,
    "poll_ms": 1000,
    "health_path": "/",
    "health_max_status": 399,
    "log_tail_lines": 40,
    "home": "/tmp/home",
    "env": {
      "CI": "1",
      "NODE_ENV": "production",
      "npm_config_update_notifier": "false"
    },
    "lockfiles": {
      "package-lock.json": "npm",
      "npm-shrinkwrap.json": "npm",
      "yarn.lock": "yarn",
      "pnpm-lock.yaml": "pnpm"
    },
    "install": {
      "npm": "npm ci --ignore-scripts --include=dev --no-audit --no-fund",
      "yarn": "corepack yarn install --frozen-lockfile --ignore-scripts --production=false",
      "pnpm": "corepack pnpm install --frozen-lockfile --ignore-scripts --prod=false"
    },
    "run_script": {
      "npm": "npm run",
      "yarn": "corepack yarn run",
      "pnpm": "corepack pnpm run"
    },
    "build_script": "build",
    "serve_presets": [
      {
        "dependency": "vite",
        "command": "npx --no-install vite preview --host 0.0.0.0 --port {port} --strictPort"
      },
      {
        "dependency": "next",
        "command": "npx --no-install next start -H 0.0.0.0 -p {port}"
      }
    ],
    "serve_scripts": [
      "start",
      "serve",
      "preview"
    ]
  },
  "kane": {
    "command": "kane-cli",
    "chrome_path": "",
    "chrome_dir": "~/.local/share/bumpproof/chrome",
    "chrome_names": [
      "google-chrome",
      "google-chrome-stable",
      "chromium",
      "chromium-browser"
    ],
    "credit_hard_stop": 9000,
    "census_budget": 4000,
    "testmd_args": [
      "--agent",
      "--headless",
      "--bug-detection",
      "continue"
    ],
    "ledger_path": "census/kredit.json",
    "bug_result_code": 740
  },
  "fixer": {
    "command": "claude",
    "model": "claude-opus-5-5",
    "max_attempts": 2,
    "max_patch_lines": 300
  },
  "github": {
    "command": "gh"
  },
  "doctor": {
    "timeout_ms": 45000
  },
  "publish": {
    "email_allowlist": [
      "example.com",
      "noreply.github.com"
    ],
    "strip_keys": [
      "email",
      "user_email",
      "username",
      "user_name",
      "ran_by",
      "run_by",
      "test_url",
      "share_url",
      "cookie",
      "set-cookie",
      "authorization",
      "proxy-authorization",
      "access_key",
      "accesskey",
      "x-api-key"
    ],
    "email_ignore_tlds": [
      "png",
      "jpg",
      "jpeg",
      "gif",
      "svg",
      "webp",
      "avif",
      "js",
      "mjs",
      "css",
      "map",
      "json",
      "ts",
      "tsx"
    ],
    "private_url_patterns": [
      "https?://[a-z0-9.-]*lambdatest(?:internal)?\\.com[^\\s\"'<>)\\]]*",
      "https?://[a-z0-9.-]*test-manager[^\\s\"'<>)\\]]*"
    ],
    "secret_env": [
      "KANE_USERNAME",
      "BUMPPROOF_PRIVATE_EMAILS"
    ],
    "scan_dirs": [
      "docs",
      "census"
    ],
    "scan_exts": [
      "html",
      "htm",
      "json",
      "ndjson",
      "md",
      "txt",
      "js",
      "css",
      "svg",
      "xml",
      "csv"
    ]
  },
  "bump": {
    "dep_fields": [
      "dependencies",
      "devDependencies",
      "optionalDependencies",
      "peerDependencies"
    ]
  },
  "compare": {
    "console_errors_fail": false,
    "network_errors_fail": false,
    "network_min_status": 400,
    "inconclusive_retries": 1
  },
  "evidence": {
    "image_exts": [
      "png",
      "jpg",
      "jpeg",
      "webp"
    ]
  },
  "app": {
    "dir": "",
    "install": "",
    "build": "",
    "serve": ""
  }
}

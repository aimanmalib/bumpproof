{
  "name": "bumpproof",
  "version": "0.1.0",
  "description": "Checks dependency-bump pull requests in a real browser with Kane CLI, and has a coding agent fix what breaks.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "bumpproof": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/runs/",
    "docs/assets/",
    "config/",
    "locales/",
    "prompts/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
